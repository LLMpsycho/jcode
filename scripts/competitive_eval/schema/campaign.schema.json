{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Competitive evaluation campaign",
  "type": "object",
  "required": [
    "campaign_id",
    "jcode",
    "omp",
    "provider",
    "model",
    "host",
    "task_manifest_sha256",
    "verifier_sha256"
  ],
  "properties": {
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "jcode": {
      "$ref": "#/$defs/version"
    },
    "omp": {
      "$ref": "#/$defs/version"
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "reasoning_effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "service_tier": {
      "type": [
        "string",
        "null"
      ]
    },
    "seed": {
      "type": "integer"
    },
    "host": {
      "type": "object",
      "required": [
        "os",
        "arch"
      ],
      "properties": {
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "cpu": {
          "type": "string"
        },
        "ram_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "task_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verifier_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "required": [
        "repo",
        "git_sha",
        "binary_sha256",
        "version"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "git_sha": {
          "type": "string"
        },
        "binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
