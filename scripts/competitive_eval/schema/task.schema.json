{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Competitive evaluation task",
  "type": "object",
  "required": [
    "id",
    "category",
    "description",
    "fixture",
    "prompt_file",
    "verifier",
    "agent",
    "expected"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "fixture": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "start_commit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "setup": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "command": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "prompt_file": {
      "type": "string"
    },
    "verifier": {
      "type": "object",
      "required": [
        "command",
        "timeout_seconds"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "required": [
        "timeout_seconds"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "required": [
        "exit_code"
      ],
      "properties": {
        "exit_code": {
          "type": "integer"
        },
        "forbidden_side_effects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
